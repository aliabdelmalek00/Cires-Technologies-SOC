version: "3.9"

secrets:
  wazuh_api_credentials: { external: true }
  dashboard_credentials: { external: true }
  indexer_credentials: { external: true }
  
networks:
  wazuh-net:
    external: true

services:
  nginx:
    image: nginx:stable
    hostname: nginx
    deploy:
      replicas: 1
      restart_policy:
        condition: any
      placement:
        constraints:
          - node.role == worker
    ports:
      - target: 1514
        published: 1514
    networks:
      - wazuh-net
    volumes:
      - /share/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      
  wazuh-master:
    image: wazuh/wazuh-manager:4.12.0
    hostname: wazuh.master
    networks:
      - wazuh-net
    deploy:
      mode: replicated
      placement:
        constraints:
          - node.role == manager
      restart_policy:
        condition: on-failure
      resources:
        limits:
          memory: 4g
        reservations:
          memory: 2g
    ulimits:
      memlock:
        soft: -1
        hard: -1
      nofile:
        soft: 655360
        hard: 655360
    secrets:
      - wazuh_api_credentials
      - dashboard_credentials
      - indexer_credentials
    environment:
      - INDEXER_URL=https://wazuh1.indexer:9200
      - INDEXER_USERNAME={{ indexer_username }}
      - INDEXER_PASSWORD={{ indexer_password }}
      - FILEBEAT_SSL_VERIFICATION_MODE=full
      - SSL_CERTIFICATE_AUTHORITIES=/etc/ssl/root-ca.pem
      - SSL_CERTIFICATE=/etc/ssl/filebeat.pem
      - SSL_KEY=/etc/ssl/filebeat.key
      - API_USERNAME={{ wazuh_api_username }}
      - API_PASSWORD={{ wazuh_api_password }}
    volumes:
      - /share/wazuh/master/api_configuration:/var/ossec/api/configuration
      - /share/wazuh/master/etc:/var/ossec/etc
      - /share/wazuh/master/logs:/var/ossec/logs
      - /share/wazuh/master/queue:/var/ossec/queue
      - /share/wazuh/master/var-multigroups:/var/ossec/var/multigroups
      - /share/wazuh/master/integrations:/var/ossec/integrations
      - /share/wazuh/master/agentless:/var/ossec/agentless
      - /share/wazuh/master/wodles:/var/ossec/wodles
      - /share/filebeat/master/etc:/etc/filebeat
      - /share/filebeat/master/var:/var/lib/filebeat
      - /share/config/wazuh_indexer_ssl_certs/root-ca-manager.pem:/etc/ssl/root-ca.pem
      - /share/config/wazuh_indexer_ssl_certs/wazuh.master.pem:/etc/ssl/filebeat.pem
      - /share/config/wazuh_indexer_ssl_certs/wazuh.master-key.pem:/etc/ssl/filebeat.key
      - /share/config/wazuh_cluster/wazuh_manager.conf:/wazuh-config-mount/etc/ossec.conf
    ports:
      - "1515:1515"
      - "514:514/udp"
      - "55000:55000"

  wazuh-worker:
    image: wazuh/wazuh-manager:4.12.0
    hostname: wazuh.worker
    networks:
      - wazuh-net
    deploy:
      mode: replicated
      placement:
        constraints:
          - node.role == worker
      restart_policy:
        condition: on-failure
      resources:
        limits:
          memory: 4g
        reservations:
          memory: 2g
    ulimits:
      memlock:
        soft: -1
        hard: -1
      nofile:
        soft: 655360
        hard: 655360
    secrets:
      - wazuh_api_credentials
      - dashboard_credentials
      - indexer_credentials
    environment:
      - INDEXER_URL=https://wazuh1.indexer:9200
      - INDEXER_USERNAME={{ indexer_username }}
      - INDEXER_PASSWORD={{ indexer_password }}
      - FILEBEAT_SSL_VERIFICATION_MODE=full
      - SSL_CERTIFICATE_AUTHORITIES=/etc/ssl/root-ca.pem
      - SSL_CERTIFICATE=/etc/ssl/filebeat.pem
      - SSL_KEY=/etc/ssl/filebeat.key
    volumes:
      - /share/wazuh/worker/api_configuration:/var/ossec/api/configuration
      - /share/wazuh/worker/etc:/var/ossec/etc
      - /share/wazuh/worker/logs:/var/ossec/logs
      - /share/wazuh/worker/queue:/var/ossec/queue
      - /share/wazuh/worker/var-multigroups:/var/ossec/var/multigroups
      - /share/wazuh/worker/integrations:/var/ossec/integrations
      - /share/wazuh/worker/agentless:/var/ossec/agentless
      - /share/wazuh/worker/wodles:/var/ossec/wodles
      - /share/filebeat/worker/etc:/etc/filebeat
      - /share/filebeat/worker/var:/var/lib/filebeat
      - /share/config/wazuh_indexer_ssl_certs/root-ca-manager.pem:/etc/ssl/root-ca.pem
      - /share/config/wazuh_indexer_ssl_certs/wazuh.worker.pem:/etc/ssl/filebeat.pem
      - /share/config/wazuh_indexer_ssl_certs/wazuh.worker-key.pem:/etc/ssl/filebeat.key
      - /share/config/wazuh_cluster/wazuh_worker.conf:/wazuh-config-mount/etc/ossec.conf

  wazuh1-indexer:
    image: wazuh/wazuh-indexer:4.12.0
    hostname: wazuh1.indexer
    networks:
      - wazuh-net
    deploy:
      restart_policy:
        condition: on-failure
      resources:
        limits:
          memory: 2g
        reservations:
          memory: 1g
    environment:
      - OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
      - bootstrap.memory_lock=true
      - OPENSEARCH_PATH_CONF=/usr/share/wazuh-indexer/config
    ulimits:
      memlock:
        soft: -1
        hard: -1
      nofile:
        soft: 65536
        hard: 65536
    volumes:
      - /share/wazuh/indexer1/data:/var/lib/wazuh-indexer
      - /share/config/wazuh_indexer_ssl_certs/root-ca.pem:/usr/share/wazuh-indexer/certs/root-ca.pem
      - /share/config/wazuh_indexer_ssl_certs/wazuh1.indexer-key.pem:/usr/share/wazuh-indexer/certs/wazuh1.indexer.key
      - /share/config/wazuh_indexer_ssl_certs/wazuh1.indexer.pem:/usr/share/wazuh-indexer/certs/wazuh1.indexer.pem
      - /share/config/wazuh_indexer_ssl_certs/admin.pem:/usr/share/wazuh-indexer/certs/admin.pem
      - /share/config/wazuh_indexer_ssl_certs/admin-key.pem:/usr/share/wazuh-indexer/certs/admin-key.pem
      - /share/config/wazuh_indexer/wazuh1.indexer.yml:/usr/share/wazuh-indexer/opensearch.yml
      - /share/config/wazuh_indexer/internal_users.yml:/usr/share/wazuh-indexer/opensearch-security/internal_users.yml
    ports:
      - "9200:9200"

  wazuh2-indexer:
    image: wazuh/wazuh-indexer:4.12.0
    hostname: wazuh2.indexer
    networks:
      - wazuh-net
    deploy:
      restart_policy:
        condition: on-failure
      resources:
        limits:
          memory: 2g
        reservations:
          memory: 1g
    environment:
      - OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
      - bootstrap.memory_lock=true
      - OPENSEARCH_PATH_CONF=/usr/share/wazuh-indexer/config
    ulimits:
      memlock:
        soft: -1
        hard: -1
      nofile:
        soft: 65536
        hard: 65536
    volumes:
      - /share/wazuh/indexer2/data:/var/lib/wazuh-indexer
      - /share/config/wazuh_indexer_ssl_certs/root-ca.pem:/usr/share/wazuh-indexer/certs/root-ca.pem
      - /share/config/wazuh_indexer_ssl_certs/wazuh2.indexer-key.pem:/usr/share/wazuh-indexer/certs/wazuh2.indexer.key
      - /share/config/wazuh_indexer_ssl_certs/wazuh2.indexer.pem:/usr/share/wazuh-indexer/certs/wazuh2.indexer.pem
      - /share/config/wazuh_indexer/wazuh2.indexer.yml:/usr/share/wazuh-indexer/opensearch.yml
      - /share/config/wazuh_indexer/internal_users.yml:/usr/share/wazuh-indexer/opensearch-security/internal_users.yml

  wazuh3-indexer:
    image: wazuh/wazuh-indexer:4.12.0
    hostname: wazuh3.indexer
    networks:
      - wazuh-net
    deploy:
      restart_policy:
        condition: on-failure
      resources:
        limits:
          memory: 2g
        reservations:
          memory: 1g
    environment:
      - OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
      - bootstrap.memory_lock=true
      - OPENSEARCH_PATH_CONF=/usr/share/wazuh-indexer/config
    ulimits:
      memlock:
        soft: -1
        hard: -1
      nofile:
        soft: 65536
        hard: 65536
    volumes:
      - /share/wazuh/indexer3/data:/var/lib/wazuh-indexer
      - /share/config/wazuh_indexer_ssl_certs/root-ca.pem:/usr/share/wazuh-indexer/certs/root-ca.pem
      - /share/config/wazuh_indexer_ssl_certs/wazuh3.indexer-key.pem:/usr/share/wazuh-indexer/certs/wazuh3.indexer.key
      - /share/config/wazuh_indexer_ssl_certs/wazuh3.indexer.pem:/usr/share/wazuh-indexer/certs/wazuh3.indexer.pem
      - /share/config/wazuh_indexer/wazuh3.indexer.yml:/usr/share/wazuh-indexer/opensearch.yml
      - /share/config/wazuh_indexer/internal_users.yml:/usr/share/wazuh-indexer/opensearch-security/internal_users.yml

  wazuh-dashboard:
    image: wazuh/wazuh-dashboard:4.12.0
    hostname: wazuh.dashboard
    networks:
      - wazuh-net
    deploy:
      restart_policy:
        condition: on-failure
    secrets:
      - wazuh_api_credentials
      - dashboard_credentials
      - indexer_credentials
    environment:
      - OPENSEARCH_HOSTS=https://wazuh1.indexer:9200
      - WAZUH_API_URL=https://wazuh.master
      - API_USERNAME={{ wazuh_api_username }}
      - API_PASSWORD={{ wazuh_api_password }}
      - DASHBOARD_USERNAME={{ dashboard_username }}
      - DASHBOARD_PASSWORD={{ dashboard_password }}
    ports:
      - 443:5601
    volumes:
      - /share/config/wazuh_indexer_ssl_certs/wazuh.dashboard.pem:/usr/share/wazuh-dashboard/certs/wazuh-dashboard.pem
      - /share/config/wazuh_indexer_ssl_certs/wazuh.dashboard-key.pem:/usr/share/wazuh-dashboard/certs/wazuh-dashboard-key.pem
      - /share/config/wazuh_indexer_ssl_certs/root-ca.pem:/usr/share/wazuh-dashboard/certs/root-ca.pem
      - /share/config/wazuh_dashboard/opensearch_dashboards.yml:/usr/share/wazuh-dashboard/config/opensearch_dashboards.yml
      - /share/config/wazuh_dashboard/wazuh.yml:/usr/share/wazuh-dashboard/data/wazuh/config/wazuh.yml
      - /share/wazuh/dashboard/config:/usr/share/wazuh-dashboard/data/wazuh/config
      - /share/wazuh/dashboard/custom:/usr/share/wazuh-dashboard/plugins/wazuh/public/assets/custom
  
