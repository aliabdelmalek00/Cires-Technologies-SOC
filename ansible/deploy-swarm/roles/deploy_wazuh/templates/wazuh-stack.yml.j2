version: "3.9"

networks:
  wazuh-net:
    external: true

services:
  traefik:
    image: traefik:v2.11
    command:
      - "--api.insecure=true"                     
      - "--providers.docker=true"
      - "--providers.docker.exposedByDefault=false"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.websecure.address=:443"
      - "--entrypoints.wazuh-tcp.address=:1514/tcp"
      - "--certificatesresolvers.le.acme.tlschallenge=true"
      - "--certificatesresolvers.le.acme.email=ali.abdelmalek00@gmail.com"
      - "--certificatesresolvers.le.acme.storage=/letsencrypt/acme.json"
    ports:
      - "80:80"
      - "443:443"
      - "1514:1514/tcp"
      - "8080:8080"
    volumes:
      - "/var/run/docker.sock:/var/run/docker.sock:ro"
      - "/share/wazuh/traefik:/letsencrypt"
    networks:
      - wazuh-net
    deploy:
      labels:
        - "traefik.enable=true"
      
  wazuh-master:
    image: wazuh/wazuh-manager:4.12.0
    hostname: wazuh.master
    networks:
      - wazuh-net
    deploy:
      mode: replicated
      replicas: 1
      restart_policy:
        condition: on-failure
      resources:
        limits:
          memory: 4g
        reservations:
          memory: 2g
    ulimits:
      memlock:
        soft: -1
        hard: -1
      nofile:
        soft: 655360
        hard: 655360
    environment:
      - INDEXER_URL=https://wazuh1.indexer:9200
      - INDEXER_USERNAME=admin
      - INDEXER_PASSWORD=SecretPassword
      - FILEBEAT_SSL_VERIFICATION_MODE=full
      - SSL_CERTIFICATE_AUTHORITIES=/etc/ssl/root-ca.pem
      - SSL_CERTIFICATE=/etc/ssl/filebeat.pem
      - SSL_KEY=/etc/ssl/filebeat.key
      - API_USERNAME=wazuh-wui
      - API_PASSWORD=MyS3cr37P450r.*-
    volumes:
      - /share/wazuh/master/api_configuration:/var/ossec/api/configuration
      - /share/wazuh/master/etc:/var/ossec/etc
      - /share/wazuh/master/logs:/var/ossec/logs
      - /share/wazuh/master/queue:/var/ossec/queue
      - /share/wazuh/master/var-multigroups:/var/ossec/var/multigroups
      - /share/wazuh/master/integrations:/var/ossec/integrations
      - /share/wazuh/master/agentless:/var/ossec/agentless
      - /share/wazuh/master/wodles:/var/ossec/wodles
      - /share/filebeat/master/etc:/etc/filebeat
      - /share/filebeat/master/var:/var/lib/filebeat
      - /share/config/wazuh_indexer_ssl_certs/root-ca-manager.pem:/etc/ssl/root-ca.pem
      - /share/config/wazuh_indexer_ssl_certs/wazuh.master.pem:/etc/ssl/filebeat.pem
      - /share/config/wazuh_indexer_ssl_certs/wazuh.master-key.pem:/etc/ssl/filebeat.key
      - /share/config/wazuh_cluster/wazuh_manager.conf:/wazuh-config-mount/etc/ossec.conf
    ports:
      - "1515:1515"
      - "514:514/udp"
      - "55000:55000"

  wazuh-worker:
    image: wazuh/wazuh-manager:4.12.0
    hostname: wazuh.worker
    networks:
      - wazuh-net
    deploy:
      mode: replicated
      replicas: 1
      restart_policy:
        condition: on-failure
      resources:
        limits:
          memory: 4g
        reservations:
          memory: 2g
    ulimits:
      memlock:
        soft: -1
        hard: -1
      nofile:
        soft: 655360
        hard: 655360
    environment:
      - INDEXER_URL=https://wazuh1.indexer:9200
      - INDEXER_USERNAME=admin
      - INDEXER_PASSWORD=SecretPassword
      - FILEBEAT_SSL_VERIFICATION_MODE=full
      - SSL_CERTIFICATE_AUTHORITIES=/etc/ssl/root-ca.pem
      - SSL_CERTIFICATE=/etc/ssl/filebeat.pem
      - SSL_KEY=/etc/ssl/filebeat.key
    volumes:
      - /share/wazuh/worker/api_configuration:/var/ossec/api/configuration
      - /share/wazuh/worker/etc:/var/ossec/etc
      - /share/wazuh/worker/logs:/var/ossec/logs
      - /share/wazuh/worker/queue:/var/ossec/queue
      - /share/wazuh/worker/var-multigroups:/var/ossec/var/multigroups
      - /share/wazuh/worker/integrations:/var/ossec/integrations
      - /share/wazuh/worker/agentless:/var/ossec/agentless
      - /share/wazuh/worker/wodles:/var/ossec/wodles
      - /share/filebeat/worker/etc:/etc/filebeat
      - /share/filebeat/worker/var:/var/lib/filebeat
      - /share/config/wazuh_indexer_ssl_certs/root-ca-manager.pem:/etc/ssl/root-ca.pem
      - /share/config/wazuh_indexer_ssl_certs/wazuh.worker.pem:/etc/ssl/filebeat.pem
      - /share/config/wazuh_indexer_ssl_certs/wazuh.worker-key.pem:/etc/ssl/filebeat.key
      - /share/config/wazuh_cluster/wazuh_worker.conf:/wazuh-config-mount/etc/ossec.conf

  wazuh1-indexer:
    image: wazuh/wazuh-indexer:4.12.0
    hostname: wazuh1.indexer
    networks:
      - wazuh-net
    deploy:
      restart_policy:
        condition: on-failure
      resources:
        limits:
          memory: 2g
        reservations:
          memory: 1g
    environment:
      - OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
      - bootstrap.memory_lock=true
    ulimits:
      memlock:
        soft: -1
        hard: -1
      nofile:
        soft: 65536
        hard: 65536
    volumes:
      - /share/wazuh/indexer1/data:/var/lib/wazuh-indexer
      - /share/config/wazuh_indexer_ssl_certs:/etc/wazuh-indexer/certs:ro
      - /share/config/wazuh_indexer_ssl_certs/admin.pem:/usr/share/wazuh-indexer/config/certs/admin.pem
      - /share/config/wazuh_indexer_ssl_certs/admin-key.pem:/usr/share/wazuh-indexer/config/certs/admin-key.pem
      - /share/config/wazuh_indexer/wazuh1.indexer.yml:/usr/share/wazuh-indexer/config/opensearch.yml
      - /share/config/wazuh_indexer/internal_users.yml:/usr/share/wazuh-indexer/config/opensearch-security/internal_users.yml
    ports:
      - "9200:9200"

  wazuh2-indexer:
    image: wazuh/wazuh-indexer:4.12.0
    hostname: wazuh2.indexer
    networks:
      - wazuh-net
    deploy:
      restart_policy:
        condition: on-failure
      resources:
        limits:
          memory: 2g
        reservations:
          memory: 1g
    environment:
      - OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
      - bootstrap.memory_lock=true
    ulimits:
      memlock:
        soft: -1
        hard: -1
      nofile:
        soft: 65536
        hard: 65536
    volumes:
      - /share/wazuh/indexer2/data:/var/lib/wazuh-indexer
      - /share/config/wazuh_indexer_ssl_certs/root-ca.pem:/usr/share/wazuh-indexer/config/certs/root-ca.pem
      - /share/config/wazuh_indexer_ssl_certs/wazuh2.indexer-key.pem:/usr/share/wazuh-indexer/config/certs/wazuh2.indexer.key
      - /share/config/wazuh_indexer_ssl_certs/wazuh2.indexer.pem:/usr/share/wazuh-indexer/config/certs/wazuh2.indexer.pem
      - /share/config/wazuh_indexer/wazuh2.indexer.yml:/usr/share/wazuh-indexer/config/opensearch.yml
      - /share/config/wazuh_indexer/internal_users.yml:/usr/share/wazuh-indexer/config/opensearch-security/internal_users.yml

  wazuh3-indexer:
    image: wazuh/wazuh-indexer:4.12.0
    hostname: wazuh3.indexer
    networks:
      - wazuh-net
    deploy:
      restart_policy:
        condition: on-failure
      resources:
        limits:
          memory: 2g
        reservations:
          memory: 1g
    environment:
      - OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
      - bootstrap.memory_lock=true
    ulimits:
      memlock:
        soft: -1
        hard: -1
      nofile:
        soft: 65536
        hard: 65536
    volumes:
      - /share/wazuh/indexer3/data:/var/lib/wazuh-indexer
      - /share/config/wazuh_indexer_ssl_certs/root-ca.pem:/usr/share/wazuh-indexer/config/certs/root-ca.pem
      - /share/config/wazuh_indexer_ssl_certs/wazuh3.indexer-key.pem:/usr/share/wazuh-indexer/config/certs/wazuh3.indexer.key
      - /share/config/wazuh_indexer_ssl_certs/wazuh3.indexer.pem:/usr/share/wazuh-indexer/config/certs/wazuh3.indexer.pem
      - /share/config/wazuh_indexer/wazuh3.indexer.yml:/usr/share/wazuh-indexer/config/opensearch.yml
      - /share/config/wazuh_indexer/internal_users.yml:/usr/share/wazuh-indexer/config/opensearch-security/internal_users.yml

  wazuh-dashboard:
    image: wazuh/wazuh-dashboard:4.12.0
    hostname: wazuh.dashboard
    networks:
      - wazuh-net
    deploy:
      restart_policy:
        condition: on-failure
      labels:
        - "traefik.enable=true"
        - "traefik.http.routers.wazuh.rule=Host(`wazuh.dashboard`)"
        - "traefik.http.routers.wazuh.entrypoints=websecure"
        - "traefik.http.routers.wazuh.tls.certresolver=letsencrypt"
        - "traefik.http.services.wazuh.loadbalancer.server.port=5601"
    environment:
      - OPENSEARCH_HOSTS=https://wazuh1.indexer:9200
      - WAZUH_API_URL=https://wazuh.master
      - API_USERNAME=wazuh-wui
      - API_PASSWORD=MyS3cr37P450r.*-
      - DASHBOARD_USERNAME=kibanaserver
      - DASHBOARD_PASSWORD=kibanaserver
    volumes:
      - /share/config/wazuh_indexer_ssl_certs/wazuh.dashboard.pem:/usr/share/wazuh-dashboard/certs/wazuh-dashboard.pem
      - /share/config/wazuh_indexer_ssl_certs/wazuh.dashboard-key.pem:/usr/share/wazuh-dashboard/certs/wazuh-dashboard-key.pem
      - /share/config/wazuh_indexer_ssl_certs/root-ca.pem:/usr/share/wazuh-dashboard/certs/root-ca.pem
      - /share/config/wazuh_dashboard/opensearch_dashboards.yml:/usr/share/wazuh-dashboard/config/opensearch_dashboards.yml
      - /share/config/wazuh_dashboard/wazuh.yml:/usr/share/wazuh-dashboard/data/wazuh/config/wazuh.yml
      - /share/wazuh/dashboard/config:/usr/share/wazuh-dashboard/data/wazuh/config
      - /share/wazuh/dashboard/custom:/usr/share/wazuh-dashboard/plugins/wazuh/public/assets/custom
  
